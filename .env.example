# ═══════════════════════════════════════════════════════════════════════
# Unlimited-OCR 推理服务环境配置示例
#
# 用法：复制为 .env 并按需修改
#   cp .env.example .env
#
# 本文件同时覆盖两套后端方案（.env 为两份 service 共用，读取时同名变量
# 以 systemd 的 Environment 或 ExecStart 显式值为准）：
#   方案 A（当前生产）server_vllm.py — vLLM FP8 适配层（systemd unlimited-ocr-vllm）
#   方案 B（历史）    server.py      — Transformers 直接加载（systemd unlimited-ocr）
#
# 部署文档：
#   方案 A → DEPLOY_VLLM.md
#   方案 B → DEPLOY.md
#   API    → SERVER.md
# ═══════════════════════════════════════════════════════════════════════

# ── 通用（两套方案共用）──────────────────────────────────────────────

# API 返回的模型名称
SERVED_MODEL_NAME=Unlimited-OCR

# API 认证密钥（Bearer Token）。留空则不校验；
# 设置后所有请求（除 /health、/images/）需携带:
#   Authorization: Bearer <API_KEY>
API_KEY=

# 空闲自动卸载间隔（秒）。默认 900（15 分钟）
#   方案 A：空闲超时后自动 docker stop vllm-ocr 容器释放显存
#   方案 B：空闲超时后卸载进程内模型
IDLE_UNLOAD_SECONDS=900

# 看门狗检查间隔（秒）
WATCHDOG_POLL_SECONDS=10

# PDF/多图分批处理：每批最多处理多少页（防 OOM / 超 context）
MAX_PAGES_PER_BATCH=20


# ── 方案 A：vLLM 适配层（server_vllm.py）───────────────────────────────
# 当前生产。适配层不加载模型，所有推理转发给下游 vLLM docker 引擎。
# 监听端口由 systemd service 固定（ExecStart 硬编码 9705）。

# 下游 vLLM 引擎 OpenAI 兼容端点（base URL）
VLLM_URL=http://127.0.0.1:9706/v1

# 引擎 docker 容器名（空闲卸载 / 自动拉起时管理该容器）
VLLM_CONTAINER=vllm-ocr

# 容器不存在时用于重建的 docker run 参数（默认内置，见 server_vllm.py）。
# 一般无需在 .env 覆盖。
# VLLM_START_ARGS=

# 启动容器后等待引擎就绪的超时时间（秒）。FP8 冷启动约 30-40s。
VLLM_START_TIMEOUT=240

# 单次生成 token 上限
VLLM_MAX_TOKENS=8192

# 单次请求最多图片数（受引擎 max-model-len=32768 与 image token 限制）
VLLM_MAX_IMAGES_PER_REQ=3

# 引擎内模型名（与 docker run 的 --served-model-name 一致）
ENGINE_MODEL_NAME=Unlimited-OCR

# NGram 防重复参数（经 vllm_xargs 透传给引擎 NGramPerReqLogitsProcessor。
# 注意：缺省即禁用防重复，模型短句循环时无防护，勿删！）
# ngram_size: 重复检测窗口长度（token）；越小越敏感、阻断越快
# window_size: 回看历史窗口（token）；越小误伤越少
NGRAM_SIZE=35
NGRAM_WINDOW=128


# ── 方案 B：Transformers 版（server.py，历史，保留可回退）─────────────

# 模型本地路径（必须是官方 bf16 safetensors）
MODEL_PATH=/data/www/models/Unlimited-OCR

# 监听地址和端口（注意：方案 B 与方案 A 共用 9705，不能同时运行。
# 方案 A 由 systemd 固定 9705 且优先于本文件；本文件 PORT 仅供方案 B 参考）
HOST=0.0.0.0
PORT=9705
